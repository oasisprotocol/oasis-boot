From: Oasis <info@oasis.net>
Subject: [PATCH] BaseTools: carry debug prefix maps into GCC and NASM

Upstream-Status: Inappropriate [Yocto reproducible builds]

diff --git a/BaseTools/Conf/tools_def.template b/BaseTools/Conf/tools_def.template
index 72ca0dfa21..ed03e4fe93 100644
--- a/BaseTools/Conf/tools_def.template
+++ b/BaseTools/Conf/tools_def.template
@@ -587,7 +587,7 @@ NOOPT_*_*_OBJCOPY_ADDDEBUGFLAG     = --add-gnu-debuglink="$(DEBUG_DIR)/$(MODULE_
 *_*_*_DTC_PATH                     = DEF(DTC_BIN)
 
 # Because LOONGARCH64 supports global stack protector guard by default, it does not support the parameter -mstack-protector-guard=global, and this parameter will be supported in GCC17. So set that on every thing except LOONGARCH64.
-DEFINE GCC_ALL_CC_COMMON               = -g -Os -fshort-wchar -fno-builtin -fno-strict-aliasing -Wall -Werror -Wno-array-bounds -include AutoGen.h -fno-common -fstack-protector
+DEFINE GCC_ALL_CC_COMMON               = -g -Os -fshort-wchar -fno-builtin -fno-strict-aliasing -Wall -Werror -Wno-array-bounds -include AutoGen.h -fno-common -fstack-protector ENV(GCC_PREFIX_MAP)
 DEFINE GCC_IA32_X64_CC_FLAGS           = -mstack-protector-guard=global
 DEFINE GCC_LOONGARCH64_CC_FLAGS        = DEF(GCC_ALL_CC_COMMON) -mabi=lp64d -fno-asynchronous-unwind-tables -Wno-address -fno-short-enums -fsigned-char -ffunction-sections -fdata-sections -march=loongarch64 -mno-memcpy -Werror -Wno-maybe-uninitialized -Wno-stringop-overflow -Wno-pointer-to-int-cast -no-pie -mno-explicit-relocs -mno-relax
 DEFINE GCC_AARCH64_CC_COMMON           = DEF(GCC_ALL_CC_COMMON) -mlittle-endian -fno-short-enums -fverbose-asm -funsigned-char  -ffunction-sections -fdata-sections -Wno-address -fno-asynchronous-unwind-tables -fno-unwind-tables -fno-pic -fno-pie -ffixed-x18 -mstack-protector-guard=global
@@ -598,8 +598,8 @@ DEFINE GCC_AARCH64_DLINK_COMMON        = -Wl,--emit-relocs -nostdlib -Wl,--gc-se
 DEFINE GCC_LOONGARCH64_DLINK_COMMON    = -Wl,--emit-relocs -nostdlib -Wl,--gc-sections -u $(IMAGE_ENTRY_POINT) -Wl,-e,$(IMAGE_ENTRY_POINT),-Map,$(DEST_DIR_DEBUG)/$(BASE_NAME).map -z common-page-size=0x20
 DEFINE GCC_AARCH64_ASLDLINK_COMMON     = DEF(GCC_AARCH64_DLINK_COMMON) -Wl,--entry,ReferenceAcpiTable -u $(IMAGE_ENTRY_POINT) -Wl,--defsym=PECOFF_HEADER_SIZE=0 DEF(GCC_DLINK2_FLAGS_COMMON) -z common-page-size=0x20
 DEFINE GCC_LOONGARCH64_ASLDLINK_COMMON = DEF(GCC_LOONGARCH64_DLINK_COMMON) -Wl,--entry,ReferenceAcpiTable -u $(IMAGE_ENTRY_POINT)
-DEFINE GCC_ASM_COMMON                  = -c -x assembler
-DEFINE GCC_PP_FLAGS                    = -E -x assembler-with-cpp -include AutoGen.h
+DEFINE GCC_ASM_COMMON                  = -c -x assembler ENV(GCC_PREFIX_MAP)
+DEFINE GCC_PP_FLAGS                    = -E -x assembler-with-cpp -include AutoGen.h ENV(GCC_PREFIX_MAP)
 DEFINE GCC_VFRPP_FLAGS                 = -x c -E -DVFRCOMPILE --include $(MODULE_NAME)StrDefs.h
 DEFINE GCC_ASLPP_FLAGS                 = -x c -E -include AutoGen.h
 DEFINE GCC_ASLCC_COMMON                = -x c -include AutoGen.h -fshort-wchar
@@ -717,7 +717,7 @@ DEFINE GCC_LOONGARCH64_PP_FLAGS            = -mabi=lp64d -march=loongarch64 DEF(
 *_GCCNOLTO_IA32_DLINK2_FLAGS         = DEF(GCCNOLTO_IA32_DLINK2_FLAGS)
 *_GCCNOLTO_IA32_RC_FLAGS             = DEF(GCC_IA32_RC_FLAGS)
 *_GCCNOLTO_IA32_OBJCOPY_FLAGS        =
-*_GCCNOLTO_IA32_NASM_FLAGS           = -f elf32
+*_GCCNOLTO_IA32_NASM_FLAGS           = -f elf32 ENV(NASM_PREFIX_MAP)
 
   DEBUG_GCCNOLTO_IA32_CC_FLAGS       = DEF(GCCNOLTO_IA32_CC_FLAGS)
 RELEASE_GCCNOLTO_IA32_CC_FLAGS       = DEF(GCCNOLTO_IA32_CC_FLAGS)
@@ -745,7 +745,7 @@ RELEASE_GCCNOLTO_IA32_CC_FLAGS       = DEF(GCCNOLTO_IA32_CC_FLAGS)
 *_GCCNOLTO_X64_DLINK2_FLAGS         = DEF(GCCNOLTO_X64_DLINK2_FLAGS)
 *_GCCNOLTO_X64_RC_FLAGS             = DEF(GCC_X64_RC_FLAGS)
 *_GCCNOLTO_X64_OBJCOPY_FLAGS        =
-*_GCCNOLTO_X64_NASM_FLAGS           = -f elf64
+*_GCCNOLTO_X64_NASM_FLAGS           = -f elf64 ENV(NASM_PREFIX_MAP)
 
   DEBUG_GCCNOLTO_X64_CC_FLAGS       = DEF(GCCNOLTO_X64_CC_FLAGS)
 RELEASE_GCCNOLTO_X64_CC_FLAGS       = DEF(GCCNOLTO_X64_CC_FLAGS)
@@ -830,7 +830,7 @@ RELEASE_GCCNOLTO_AARCH64_DLINK_FLAGS  = DEF(GCCNOLTO_AARCH64_DLINK_FLAGS)
 *_GCC_IA32_DLINK2_FLAGS         = DEF(GCC_IA32_DLINK2_FLAGS) -no-pie
 *_GCC_IA32_RC_FLAGS             = DEF(GCC_IA32_RC_FLAGS)
 *_GCC_IA32_OBJCOPY_FLAGS        =
-*_GCC_IA32_NASM_FLAGS           = -f elf32
+*_GCC_IA32_NASM_FLAGS           = -f elf32 ENV(NASM_PREFIX_MAP)
 
   DEBUG_GCC_IA32_CC_FLAGS       = DEF(GCC_IA32_CC_FLAGS) -flto
   DEBUG_GCC_IA32_DLINK_FLAGS    = DEF(GCC_IA32_X64_DLINK_FLAGS) -flto -Os -Wl,-m,elf_i386,--oformat=elf32-i386 -z common-page-size=0x40
@@ -862,7 +862,7 @@ RELEASE_GCC_IA32_DLINK_FLAGS    = DEF(GCC_IA32_X64_DLINK_FLAGS) -flto -Os -Wl,-m
 *_GCC_X64_DLINK2_FLAGS          = DEF(GCC_X64_DLINK2_FLAGS)
 *_GCC_X64_RC_FLAGS              = DEF(GCC_X64_RC_FLAGS)
 *_GCC_X64_OBJCOPY_FLAGS         =
-*_GCC_X64_NASM_FLAGS            = -f elf64
+*_GCC_X64_NASM_FLAGS            = -f elf64 ENV(NASM_PREFIX_MAP)
 
   DEBUG_GCC_X64_CC_FLAGS        = DEF(GCC_X64_CC_FLAGS) -flto -DUSING_LTO
   DEBUG_GCC_X64_DLINK_FLAGS     = DEF(GCC_X64_DLINK_FLAGS) -flto -Os -z common-page-size=0x1000
@@ -966,7 +966,7 @@ RELEASE_GCC_AARCH64_DLINK_FLAGS = DEF(GCC_AARCH64_DLINK_FLAGS) -flto -Os -L$(WOR
 *_GCC_LOONGARCH64_DLINK2_FLAGS         = DEF(GCC_LOONGARCH64_DLINK2_FLAGS)
 *_GCC_LOONGARCH64_RC_FLAGS             = DEF(GCC_LOONGARCH64_RC_FLAGS)
 *_GCC_LOONGARCH64_OBJCOPY_FLAGS        =
-*_GCC_LOONGARCH64_NASM_FLAGS           = -f elf32
+*_GCC_LOONGARCH64_NASM_FLAGS           = -f elf32 ENV(NASM_PREFIX_MAP)
 *_GCC_LOONGARCH64_PP_FLAGS             = DEF(GCC_LOONGARCH64_PP_FLAGS)
 
 DEBUG_GCC_LOONGARCH64_CC_FLAGS         = DEF(GCC_LOONGARCH64_CC_FLAGS)
